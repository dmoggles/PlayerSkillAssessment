# Backup settings for deploy/backup.sh. Place as .backup.env in the deployment directory, mode 600, off Git.

# Public key from `age-keygen -o tapline-idp-backup.key` (run on your own computer). The private key file stays
# off the servers: keep it in a password manager and a second safe place. Without it no backup can be read.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key

# Off-server copy 1: an S3-compatible bucket in the UK/EU, through rclone, configured here without a config file.
# Example for Backblaze B2 (EU Central); create an application key restricted to this bucket WITHOUT deleteFiles,
# and set the bucket's lifecycle rules to remove old files (daily/ after 35 days, pre-deploy/ after 120,
# monthly/ after 400).
BACKUP_REMOTE=offsite:replace-with-bucket-name
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=replace-me
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=replace-me

# Off-server copy 2: the other VPS, set up with deploy/setup_backup_mirror.sh. Leave blank to skip.
BACKUP_MIRROR=idpbackup@replace-with-dev-vps-hostname:
BACKUP_MIRROR_SSH_KEY=/home/replace-with-deploy-user/.ssh/tapline_idp_backup

# A dead-man's switch, e.g. a free check at healthchecks.io set to expect one ping a day. It alerts you when a
# nightly backup fails or doesn't run at all.
BACKUP_HEALTHCHECK_URL=

# Optional: where backups are kept on this server, and how many of each kind.
# BACKUP_DIR=/var/backups/tapline-idp
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_MONTHLY=12
# BACKUP_KEEP_PREDEPLOY=10
