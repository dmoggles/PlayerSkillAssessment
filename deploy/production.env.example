# Place as .env.prod in the production deployment directory; keep it off Git.
PUBLIC_BASE_URL=https://assessment.example.com
SECURE_COOKIES=true
POSTGRES_OWNER_PASSWORD=replace-with-random-owner-password
APP_DB_PASSWORD=replace-with-random-app-password
DATABASE_URL=postgresql+psycopg://assessment_app:replace-with-random-app-password@db:5432/assessment
MIGRATION_DATABASE_URL=postgresql+psycopg://assessment_owner:replace-with-random-owner-password@db:5432/assessment
API_IMAGE=ghcr.io/dmoggles/playerskillassessment-api:latest
WEB_IMAGE=ghcr.io/dmoggles/playerskillassessment-web:latest
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=assessment@example.com
