# Place as .env.dev in a separate development deployment directory; keep it off Git.
# Host Nginx proxies the development domain to 127.0.0.1:8083.
PUBLIC_BASE_URL=https://dev-assessment.example.com
SECURE_COOKIES=true
POSTGRES_OWNER_PASSWORD=replace-with-random-dev-owner-password
APP_DB_PASSWORD=replace-with-random-dev-app-password
DATABASE_URL=postgresql+psycopg://assessment_app:replace-with-random-dev-app-password@db:5432/assessment
MIGRATION_DATABASE_URL=postgresql+psycopg://assessment_owner:replace-with-random-dev-owner-password@db:5432/assessment
API_IMAGE=ghcr.io/dmoggles/playerskillassessment-api:dev
WEB_IMAGE=ghcr.io/dmoggles/playerskillassessment-web:dev
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=assessment-dev@localhost
