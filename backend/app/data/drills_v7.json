  "drills": [
    {
      "slug": "four-corner-pass-and-follow",
      "title": "Four-corner pass and follow",
      "summary": "Pass round a square and follow your pass, so everyone keeps moving.",
      "format": "small_group",
      "players": [
        5,
        8,
        12
      ],
      "ages": [
        8,
        14
      ],
      "duration": [
        10,
        15
      ],
      "session_phase": "technical",
      "intensity": "medium",
      "space": [
        12,
        12
      ],
      "home_friendly": false,
      "equipment": [
        {
          "item": "cones",
          "quantity": 4
        },
        {
          "item": "balls",
          "quantity": 2
        }
      ],
      "setup": "A 12 x 12 m square with a cone at each corner: 10 m for U8–U9, up to 15 m for U13–U14. Two players at each corner, more if you have them. The first players at two opposite corners have a ball each.",
      "instructions": [
        "The first player at each corner with a ball passes to the next corner, clockwise.",
        "Pass, then jog after your pass to join the back of that corner's line.",
        "Both balls go round at once, so look before you pass.",
        "After two minutes, change direction."
      ],
      "coaching_points": [
        "Step out to meet the ball; don't wait on the cone.",
        "Receive across your body, on the back foot.",
        "Pass to the receiver's back foot, the one further from you, so they can play on in one movement.",
        "Call the receiver's name before you pass."
      ],
      "tags": {
        "passing_short": 1.0,
        "first_touch": 0.5
      },
      "variations": [
        {
          "kind": "regression",
          "title": "One ball",
          "levels": [
            1,
            2
          ],
          "change": "One ball only, and two touches allowed, so there's time to look up.",
          "equipment": [
            {
              "item": "cones",
              "quantity": 4
            },
            {
              "item": "balls",
              "quantity": 1
            }
          ],
          "setup": "A 12 x 12 m square with a cone at each corner: 10 m for U8–U9, up to 15 m for U13–U14. Two players at each corner, more if you have them. The first player at one corner has the ball.",
          "instructions": [
            "The player with the ball passes to the next corner, clockwise.",
            "Pass, then jog after your pass to join the back of that corner's line.",
            "Take two touches: one to control, one to pass.",
            "After two minutes, change direction."
          ]
        },
        {
          "kind": "base",
          "title": "Four-corner pass and follow",
          "levels": [
            2,
            3
          ],
          "diagram": 0,
          "change": "Two balls go round at once, from opposite corners, with as many touches as you need."
        },
        {
          "kind": "escalator",
          "title": "One touch, two balls",
          "levels": [
            3,
            4
          ],
          "change": "One touch at every corner, with both balls going."
        },
        {
          "kind": "escalator",
          "title": "Give-and-go at each corner",
          "levels": [
            4,
            5
          ],
          "diagram": 1,
          "change": "The receiver sets it back first time, turns towards the next corner and gets it back in their path, then passes on.",
          "instructions": [
            "The first player at each corner with a ball passes to the next corner, clockwise.",
            "The passer steps in; the receiver sets it back first time.",
            "The receiver turns towards the next corner; the passer plays it into their path, then follows to the back of that line.",
            "The receiver passes on to the next corner, and the give-and-go starts again there.",
            "After two minutes, change direction."
          ],
          "coaching_points": [
            "Set it back firmly, to the passer's front foot.",
            "Turn as the ball leaves you, so you're already moving onto the return.",
            "Play the return into space ahead of the runner, not to their feet.",
            "Call the receiver's name before you pass."
          ]
        }
      ],
